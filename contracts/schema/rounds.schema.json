{
  "title": "关卡配置（PRD v0.3 §3）",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rules_version": {
      "type": "string",
      "minLength": 1
    },
    "content_version": {
      "type": "string",
      "minLength": 1
    },
    "rounds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "round_id": {
            "type": "string",
            "enum": [
              "R1",
              "R2",
              "R3",
              "R4",
              "R5",
              "R6"
            ]
          },
          "act": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              }
            ]
          },
          "label": {
            "type": "string",
            "pattern": "^[A-F]$"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "claim_direction": {
            "type": "string",
            "enum": [
              "holds",
              "fails",
              "unverifiable"
            ]
          },
          "horizon": {
            "type": "string",
            "enum": [
              "past",
              "future"
            ]
          },
          "evidence_verdict": {
            "type": "string",
            "enum": [
              "supports",
              "refutes",
              "insufficient"
            ]
          },
          "key_card": {
            "type": "string",
            "enum": [
              "fox",
              "elephant",
              "leopard"
            ]
          },
          "named_card": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "fox",
                  "elephant",
                  "leopard"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "bet_family": {
            "type": "string",
            "enum": [
              "relative_strength",
              "steady_trend",
              "volume_surge"
            ]
          },
          "cards": {
            "type": "object",
            "properties": {
              "fox": {
                "type": "object",
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "ref",
                  "title"
                ],
                "additionalProperties": false
              },
              "elephant": {
                "type": "object",
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "ref",
                  "title"
                ],
                "additionalProperties": false
              },
              "leopard": {
                "type": "object",
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "ref",
                  "title"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "fox",
              "elephant",
              "leopard"
            ],
            "additionalProperties": false
          },
          "explain": {
            "type": "object",
            "properties": {
              "fox": {
                "type": "object",
                "properties": {
                  "content_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "neutral",
                      "directional"
                    ]
                  }
                },
                "required": [
                  "content_id",
                  "version",
                  "kind"
                ],
                "additionalProperties": false
              },
              "elephant": {
                "type": "object",
                "properties": {
                  "content_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "neutral",
                      "directional"
                    ]
                  }
                },
                "required": [
                  "content_id",
                  "version",
                  "kind"
                ],
                "additionalProperties": false
              },
              "leopard": {
                "type": "object",
                "properties": {
                  "content_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "neutral",
                      "directional"
                    ]
                  }
                },
                "required": [
                  "content_id",
                  "version",
                  "kind"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "fox",
              "elephant",
              "leopard"
            ],
            "additionalProperties": false
          },
          "followups": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "order": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "question": {
                  "type": "string",
                  "enum": [
                    "missing",
                    "basis",
                    "waiting"
                  ]
                },
                "trigger": {
                  "type": "string",
                  "enum": [
                    "final_insufficient",
                    "key_card_flipped_and_verdict_differs",
                    "action_wait"
                  ]
                },
                "options": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "comparison",
                      "longer_history",
                      "signal_validation",
                      "future_trend",
                      "more_opinions",
                      "chart_unclear",
                      "own_view",
                      "main_chart",
                      "opened_cards",
                      "claim_itself",
                      "intuition",
                      "other",
                      "skipped"
                    ]
                  }
                },
                "understanding_answers": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "comparison",
                      "longer_history",
                      "signal_validation",
                      "future_trend",
                      "more_opinions",
                      "chart_unclear",
                      "own_view",
                      "main_chart",
                      "opened_cards",
                      "claim_itself",
                      "intuition",
                      "other",
                      "skipped"
                    ]
                  }
                }
              },
              "required": [
                "order",
                "question",
                "trigger",
                "options"
              ],
              "additionalProperties": false
            }
          },
          "method_card": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "granted": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "granted"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "round_id",
          "act",
          "label",
          "claim",
          "claim_direction",
          "horizon",
          "evidence_verdict",
          "key_card",
          "named_card",
          "bet_family",
          "cards",
          "explain",
          "followups",
          "method_card"
        ],
        "additionalProperties": false
      }
    },
    "bet_family_coverage": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "relative_strength",
          "steady_trend",
          "volume_surge"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "required": [
        "relative_strength",
        "steady_trend",
        "volume_surge"
      ]
    }
  },
  "required": [
    "rules_version",
    "content_version",
    "rounds",
    "bet_family_coverage"
  ],
  "additionalProperties": false
}

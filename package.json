{
  "name": "pandaai-hackathon-next-card",
  "version": "0.4.1",
  "private": true,
  "description": "下一张牌：晨光小城卡牌冒险，结合历史契约、研究观察与可操作的个性化任务。PandaAI 苏客松赛道。",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build && node scripts/check-secrets.mjs dist",
    "build:pages": "npm test && npm run lint && npm run build && npm run check:secrets",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:py": ".venv/bin/python -m unittest discover -s scripts/tests",
    "lint": "tsc --noEmit",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wenan4/pandaai-hackathon-next-card.git"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/zcool-qingke-huangyou": "^5.3.0",
    "zod": "4.6.7"
  }
}
